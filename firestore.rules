rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user document
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserDoc().data.isAdmin == true;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Authenticated users can read all user documents (needed for leaderboard)
      // Users can read their own document
      allow read: if isAuthenticated();
      
      // Users can create their own document during registration
      allow create: if isAuthenticated() && isOwner(userId);
      
      // Only admins can update user documents (for isAdmin flag, etc.)
      // Users can update their own basic info (but not isAdmin)
      allow update: if isAdmin() || 
                     (isOwner(userId) && 
                      !('isAdmin' in request.resource.data.diff(resource.data).affectedKeys()));
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // Games collection (year-based)
    match /games/{year} {
      // Anyone authenticated can read game status
      allow read: if isAuthenticated();
      
      // Only admins can write to game documents
      allow write: if isAdmin();
      
      // Prop questions subcollection
      match /propQuestions/{questionId} {
        // Anyone authenticated can read questions
        allow read: if isAuthenticated();
        
        // Only admins can create, update, or delete questions
        allow write: if isAdmin();
      }
      
      // Prop entries subcollection (user submissions)
      match /propEntries/{entryId} {
        // Users can read all entries (for leaderboard)
        allow read: if isAuthenticated();
        
        // Users can create their own entries
        allow create: if isAuthenticated() && 
                        request.resource.data.user == /databases/$(database)/documents/users/$(request.auth.uid);
        
        // Users can only update their own entries (if needed)
        // Admins can update any entry (for scoring corrections)
        allow update: if isAdmin() || 
                       (isAuthenticated() && 
                        resource.data.user == /databases/$(database)/documents/users/$(request.auth.uid));
        
        // Only admins can delete entries
        allow delete: if isAdmin();
      }

      function boxesAreOpen() {
        return get(/databases/$(database)/documents/games/$(year)).data.boxesEnabled == true
          && get(/databases/$(database)/documents/games/$(year)).data.boxesStatus == "open";
      }

      // One doc per claimed square. Id is "{row}-{col}", both 0-9.
      // A tap creates the doc with submitted == false. Submit flips that to true.
      match /boxSquares/{squareId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
          && boxesAreOpen()
          && squareId.matches('^[0-9]-[0-9]$')
          && request.resource.data.keys().hasOnly(['uid', 'name', 'row', 'col', 'submitted'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() < 80
          && request.resource.data.row is int
          && request.resource.data.col is int
          && request.resource.data.row >= 0
          && request.resource.data.row <= 9
          && request.resource.data.col >= 0
          && request.resource.data.col <= 9
          && request.resource.data.submitted == false
          && squareId == string(request.resource.data.row) + '-' + string(request.resource.data.col);

        allow update: if isAdmin()
          || (isAuthenticated()
              && boxesAreOpen()
              && resource.data.uid == request.auth.uid
              && resource.data.submitted == false
              && request.resource.data.submitted == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submitted']));

        allow delete: if isAdmin()
          || (isAuthenticated()
              && boxesAreOpen()
              && resource.data.uid == request.auth.uid
              && resource.data.submitted == false);
      }

      // One doc per player. paidCount is how many submitted squares are marked paid.
      match /boxEntries/{entryId} {
        allow read: if isAuthenticated();

        allow create: if isAdmin()
          || (isAuthenticated()
              && boxesAreOpen()
              && entryId == request.auth.uid
              && request.resource.data.keys().hasOnly(['uid', 'name'])
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.name.size() < 80);

        allow update: if isAdmin()
          || (isAuthenticated()
              && boxesAreOpen()
              && entryId == request.auth.uid
              && request.resource.data.uid == resource.data.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));

        allow delete: if isAdmin();
      }
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
